# Copy this file to `.env` (same folder) to configure the app locally.
# Vite only exposes variables that start with VITE_ to the browser code.

# Base address of the school's CheapShark API (no trailing slash).
VITE_API_BASE_URL=https://apis.divtec.me/api/cheapshark

# How long to wait for an API answer before giving up, in milliseconds.
VITE_API_TIMEOUT_MS=10000
